# Copy to backend/.env and fill in. NEVER commit .env.

# --- LLM ---
# Choose: anthropic | groq
LLM_PROVIDER=groq
DEMO_OFFLINE_MODE=true

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Anthropic model selection (optional — these are the defaults)
EXTRACTION_MODEL=claude-sonnet-4-6
RESOLUTION_MODEL=claude-haiku-4-5-20251001
CONTRADICTION_EXPLANATION_MODEL=claude-haiku-4-5-20251001

# Groq (only needed when LLM_PROVIDER=groq)
# Install: pip install 'cs194w-backend[groq]'
GROQ_API_KEY=gsk_REPLACE_ME
GROQ_EXTRACTION_MODEL=llama-3.3-70b-versatile

# Max output tokens per extraction call. Too low truncates the JSON mid-response.
EXTRACTION_MAX_OUTPUT_TOKENS=8000

# Optional additive LLM pass for cross-predicate / cross-value-type contradictions.
# Off by default; turn on to showcase semantic detection (makes extra LLM calls).
SEMANTIC_CONTRADICTIONS_ENABLED=false
SEMANTIC_CONTRADICTIONS_MAX_PAIRS=50

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_local_only

# --- Postgres ---
DATABASE_URL=postgresql://cs194w:cs194w@localhost:5432/cs194w

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
