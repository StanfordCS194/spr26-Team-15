# Copy to backend/.env and fill in. NEVER commit .env.

# --- LLM ---
# Choose: anthropic | groq
LLM_PROVIDER=groq
DEMO_OFFLINE_MODE=true

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Groq (only needed when LLM_PROVIDER=groq)
# Install: pip install 'cs194w-backend[groq]'
GROQ_API_KEY=gsk_REPLACE_ME
GROQ_EXTRACTION_MODEL=llama-3.3-70b-versatile

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_local_only

# --- Postgres ---
DATABASE_URL=postgresql://cs194w:cs194w@localhost:5432/cs194w

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
